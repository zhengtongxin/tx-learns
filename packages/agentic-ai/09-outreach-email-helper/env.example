# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=YOUR_KEY_HERE

# Option A: send by email (SMTP). Use an app password, not your normal password.
SMTP_HOST=smtp.example.com
MAIL_FROM=you@example.com
MAIL_TO=you@example.com
SMTP_APP_PASSWORD=YOUR_APP_PASSWORD_HERE

# Option B (used when SMTP_APP_PASSWORD is empty): phone push with Pushover.
# With neither option set, the helper just prints the email in the terminal.
PUSHOVER_USER=YOUR_PUSHOVER_USER_KEY_HERE
PUSHOVER_TOKEN=YOUR_PUSHOVER_APP_TOKEN_HERE
