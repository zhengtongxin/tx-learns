# Copy this file to .env and fill in your own values. Never commit .env.
# Get a Google AI Studio key from aistudio.google.com
GOOGLE_API_KEY=YOUR_KEY_HERE
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model names live here so experiments stay cheap. Change them to cheaper models while testing.
COORDINATOR_MODEL=gemini-2.5-flash
WORKER_MODEL=gemini-2.5-flash
INSPECTOR_MODEL=gemini-2.5-flash
