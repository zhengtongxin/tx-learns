# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=YOUR_KEY_HERE
# Serper is the web search service (serper.dev). Each search uses your quota.
SERPER_API_KEY=YOUR_SERPER_KEY_HERE
# Optional: without these two, the picker's notification is printed instead of sent
PUSHOVER_USER=YOUR_PUSHOVER_USER_KEY_HERE
PUSHOVER_TOKEN=YOUR_PUSHOVER_APP_TOKEN_HERE
