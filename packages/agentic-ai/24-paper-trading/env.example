# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=YOUR_KEY_HERE
# Optional: web search for the researcher (tavily.com). Without it the researcher still has fetch and memory.
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE
# Optional: phone pings after trades (Pushover). Without them the push tool says "skipped".
PUSHOVER_USER=YOUR_PUSHOVER_USER_KEY_HERE
PUSHOVER_TOKEN=YOUR_PUSHOVER_APP_TOKEN_HERE

# How long the floor sleeps between rounds. Keep it long: every round costs money.
RUN_EVERY_N_MINUTES=60
# A small, cheap model name for all uncles
TRADER_MODEL=gpt-4o-mini
