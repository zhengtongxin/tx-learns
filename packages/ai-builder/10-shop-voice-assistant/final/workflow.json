        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.data[0].embedding, match_count: 3 }) }}",
        "options": {}
      },
      "name": "Search products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "id": "h2"
    },
    {
      "parameters": {
        "jsCode": "// Supabase returns one item per matching chunk. Keep the close ones, join them into one answer.\nconst rows = $input.all().map(i => i.json).filter(r => r.similarity > 0.3);\nconst answer = rows.length\n  ? rows.map(r => r.content).join(' ')\n  : 'No information found on that.';\nreturn [{ json: { answer } }];"
      },
      "name": "Facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "id": "facts"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { answer: $json.answer } }}",
        "options": {}
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "id": "r1"
    }
  ],
