# Copy this file to .env (next to the Dockerfile, in final/ or starter/) and fill in your own values.
# .env is used by "docker run --env-file .env" and by scripts/create-function.sh.
# Never commit it. Placeholders only.
OPENAI_API_KEY=YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE
CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN/.well-known/jwks.json
# Optional: only if the front end is hosted on a different address (comma separated).
# ALLOWED_ORIGINS=https://helper.example.com
