# Copy this file to .env (next to this README, in final/ or starter/).
# Load it into your shell before running the backend:   set -a; source .env; set +a
# Never commit .env. Placeholders only.

# --- the model ---
OPENAI_API_KEY=YOUR_KEY_HERE

# --- memory: local files by default ---
USE_BUCKET=false
# Only needed when USE_BUCKET=true (in the cloud scripts set this for you):
# MEMORY_BUCKET=YOUR_MEMORY_BUCKET_NAME

# --- local run: which page address may call the API ---
ALLOWED_ORIGIN=http://localhost:3000

# --- front end (put this in frontend/.env.local for "npm run dev") ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- cloud scripts (scripts/*.sh) ---
REGION=ap-southeast-1
# After you create the CDN in the console:
# DISTRIBUTION_ID=YOUR_DISTRIBUTION_ID
# SITE_BUCKET=YOUR_SITE_BUCKET_NAME
