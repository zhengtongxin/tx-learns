# Copy this file to .env (next to deploy.sh) and fill in YOUR values.
# Load it before running scripts:   set -a; source .env; set +a
# There are NO long-lived cloud keys here on purpose: your laptop signs in with the cloud CLI
# (aws configure sso / aws sso login), and the pipeline signs in with a short-lived GitHub token.
# Never commit .env. Placeholders only.

# the cloud region everything lives in
REGION=ap-southeast-1
AWS_REGION=ap-southeast-1

# your GitHub repository, exactly as GitHub spells it (owner/name)
GITHUB_REPO=YOUR_GITHUB_NAME/YOUR_REPO_NAME

# optional: name the shared-state bucket yourself (default wharf-tf-state-<account id>)
# STATE_BUCKET=wharf-tf-state-YOUR_ACCOUNT_ID

# optional: only for running the backend on your laptop (needs model access in your account)
# MODEL_ID=apac.amazon.nova-lite-v1:0
# USE_BUCKET=false
