# Copy this file to .env (next to agent.py) and load it:   set -a; source .env; set +a
# There are no keys here: sign in with the cloud CLI as your limited daily user
# (for example "aws configure sso" then "aws sso login"). Placeholders only.

# ONE region for everything: model access, the agent and the sandbox
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# Optional: your named CLI profile
# AWS_PROFILE=YOUR_PROFILE_NAME

# Optional: a model id you have access to in that region, if the default one is not enabled
# MODEL_ID=YOUR_MODEL_ID_HERE
