# Copy this file to .env, then replace the placeholder. Never commit .env.
OPENAI_API_KEY=YOUR_KEY_HERE
# Where the copilot sends its tool calls (the stand-in gateway by default).
GATEWAY_URL=http://127.0.0.1:5001
# Set to 1 to answer with simple rules instead of a model (no key, no cost).
DRY_RUN=0
