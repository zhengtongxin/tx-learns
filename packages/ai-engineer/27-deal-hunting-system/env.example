# Copy this file to .env and edit.
# 1 = demo: local stand-in agents and a sample feed, no keys, no GPU, no cost.
# 0 = real agents (fill in everything below).
DEMO_MODE=1

# How many dollars below the estimate counts as a deal, and how many validation items fit the ensemble weights.
THRESHOLD=50
VAL_SIZE=50
SEEN_FILE=seen_deals.json

# ---- Real mode only ----
OPENAI_API_KEY=YOUR_KEY_HERE
CHEAP_MODEL=gpt-5-mini
BIG_MODEL=gpt-5
# Where the current deals come from: a web address that returns text, or a local file.
FEED_URL=data/feed_sample.txt
# Phone alerts (optional; without these the messenger only logs).
PUSHOVER_APP_TOKEN=YOUR_APP_TOKEN_HERE
PUSHOVER_USER_KEY=YOUR_USER_KEY_HERE
# The tuned model you trained in the fine-tuning project, served by price_guesser.py on a serverless GPU.
BASE_MODEL=Qwen/Qwen2.5-3B
ADAPTER_ID=your-hub-name/price-run-01
