# Copy this file to .env and edit. Everything is optional except the base model (a default is set).
# A 3B to 8B open base model you are allowed to use. If it is gated, accept its licence on the hub and set HF_TOKEN.
BASE_MODEL=Qwen/Qwen2.5-3B
RUN_NAME=price-run-01
# Only for pushing the dataset and adapter to the model hub (PUSH_TO_HUB=1):
HF_TOKEN=YOUR_TOKEN_HERE
HUB_NAME=your-hub-name
PUSH_TO_HUB=0
# Only for the optional frontier row in the comparison table:
OPENAI_API_KEY=YOUR_KEY_HERE
FRONTIER_MODEL=gpt-5
FRONTIER_COST_PER_1000=1.5
# What your rented GPU costs per hour (a rough number is fine); used to price the tuned model.
GPU_HOURLY_PRICE=0.5
