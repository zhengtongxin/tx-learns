# Copy this file to .env. Everything here is optional: with no key the table shows the classic guessers only.
OPENAI_API_KEY=YOUR_KEY_HERE
# A model name your provider currently offers.
FRONTIER_MODEL=gpt-5
# Cost per 1,000 guesses from your provider's price list (a rough number is fine).
FRONTIER_COST_PER_1000=1.5
# Fill these in only after you have a tuned model (see the fine-tuning lesson). Leave empty to skip.
TUNED_MODEL=
TUNED_COST_PER_1000=0.5
