# Copy this file to .env and edit.
# Only needed if the chat model you pick is gated (you must accept its licence on the model hub first).
HF_TOKEN=YOUR_TOKEN_HERE
# Any open chat model name from the hub. This default is small and not gated.
CHAT_MODEL=Qwen/Qwen2.5-3B-Instruct
SPEECH_MODEL=openai/whisper-small
